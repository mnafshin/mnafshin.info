---
import { getPublishedEntries } from '../lib/posts';
import { SECTIONS, SITE_TITLE, withBase } from '../lib/site';
import SearchDialog from './SearchDialog.astro';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
const aiPosts = await getPublishedEntries('ai');
const navItems = SECTIONS.filter((section) => section.inNav || aiPosts.length > 0);

function isCurrent(href: string) {
  if (href === withBase()) {
    return path === href;
  }
  return path === href || path.startsWith(href);
}
---
<a class="skip-link" href="#content">Skip to content</a>
<header class="site-header">
  <div class="wrap bar">
    <a class="brand" href={withBase()}>{SITE_TITLE}</a>
    <nav class="nav" aria-label="Main">
      {navItems.map((section) => {
        const href = withBase(`${section.path}/`);
        return (
          <a href={href} aria-current={isCurrent(href) ? 'page' : undefined}>
            {section.name}
          </a>
        );
      })}
      <a
        class="search-trigger"
        href={withBase('search/')}
        aria-keyshortcuts="Control+K Meta+K /"
        data-search-open
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
          <circle cx="11" cy="11" r="6.5"/>
          <path d="m16 16 4.5 4.5" stroke-linecap="round"/>
        </svg>
        <span class="search-trigger-label">Search</span>
        <kbd class="search-kbd" data-search-kbd hidden aria-hidden="true"></kbd>
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>
<SearchDialog />

<script>
  import '../scripts/search';
</script>
