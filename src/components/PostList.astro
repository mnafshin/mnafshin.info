---
import type { CollectionEntry } from 'astro:content';
import { ogCover, youtubeThumb, type CoverImage } from '../lib/covers';
import { isPublicVideo } from '../lib/articles';
import { postPath, type PublishedPost } from '../lib/posts';
import { getSection, type SectionId, withBase } from '../lib/site';
import { readingMinutes, wordCount } from '../lib/structured-data';
import ArticleCard from './ArticleCard.astro';

interface Props {
  posts: PublishedPost[] | { sectionId: SectionId; entry: CollectionEntry<SectionId> }[];
  showSection?: boolean;
}

const { posts, showSection = false } = Astro.props;

function hrefOf(post: Props['posts'][number]) {
  if ('section' in post) {
    return withBase(postPath(post.section.id, post.entry.id));
  }
  return withBase(postPath(post.sectionId, post.entry.id));
}

function sectionOf(post: Props['posts'][number]) {
  return 'section' in post ? post.section : getSection(post.sectionId);
}

function entryOf(post: Props['posts'][number]) {
  return post.entry;
}

function metaOf(post: Props['posts'][number]) {
  const entry = entryOf(post);
  const date = entry.data.pubDate.toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'Europe/Berlin',
  });
  if (showSection) return `${sectionOf(post).name} · ${date}`;
  return date;
}

function coverOf(post: Props['posts'][number]): CoverImage | undefined {
  const entry = entryOf(post);
  const section = sectionOf(post);
  if ('relatedVideos' in entry.data) {
    const youtubeId = (entry.data.relatedVideos ?? []).find((video) => isPublicVideo(video))?.youtubeId;
    if (youtubeId) return youtubeThumb(youtubeId);
  }
  return ogCover(section.path, entry.id);
}
---
<ul class="article-cards post-list">
  {posts.map((post) => {
    const entry = entryOf(post);
    const section = sectionOf(post);
    return (
      <li>
        <ArticleCard
          href={hrefOf(post)}
          title={entry.data.title}
          description={entry.data.description}
          sectionId={section.id}
          minutes={readingMinutes(wordCount(entry.body))}
          cover={coverOf(post)}
          meta={metaOf(post)}
        />
      </li>
    );
  })}
</ul>
