---
import type { Crumb } from '../lib/nav';
import SectionIcon from './SectionIcon.astro';

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb" data-pagefind-ignore>
  <ol>
    {items.map((item, index) => {
      const last = index === items.length - 1;
      const label = (
        <>
          {item.sectionId && <SectionIcon section={item.sectionId} size={14} />}
          {item.label}
        </>
      );
      return (
        <li>
          {last || !item.href ? (
            <span aria-current={last ? 'page' : undefined}>{label}</span>
          ) : (
            <a href={item.href} data-section={item.sectionId}>{label}</a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
