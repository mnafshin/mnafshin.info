---
import { loadSectionGlossary } from '../lib/glossary';
import { getSection, type SectionId, withBase } from '../lib/site';

interface Props {
  sectionId: SectionId;
}

const { sectionId } = Astro.props;
const section = getSection(sectionId);
const count = loadSectionGlossary(sectionId, withBase()).length;
const href = withBase(`${section.path}/glossary/`);
---
<p class="glossary-index-link">
  {count > 0 ? (
    <a href={href}>A–Z glossary</a>
  ) : (
    <a href={href}>Glossary (coming soon)</a>
  )}
</p>
