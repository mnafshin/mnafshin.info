---
import type { SectionId } from '../lib/site';

interface Props {
  section: SectionId | string;
  size?: number;
}

const { section, size = 18 } = Astro.props;
---
<svg
  class="section-icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  data-section-icon={section}
>
  {section === 'spring' && (
    <g>
      <path d="M12 21V10"/>
      <path d="M12 10c-3.5-1.2-6-4-6-7 4 0 6 3.2 6 7z"/>
      <path d="M12 12c3.2 1 6 3.6 6 7-4 0-6-3-6-7z"/>
    </g>
  )}
  {section === 'terms' && (
    <g>
      <path d="M7 5h10a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H9l-4 3v-3H7a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z"/>
    </g>
  )}
  {section === 'security' && (
    <g>
      <path d="M12 3 5 6v6c0 4.2 2.9 7.6 7 8.7 4.1-1.1 7-4.5 7-8.7V6l-7-3z"/>
      <path d="M9.5 12.2 11.2 14l3.5-4"/>
    </g>
  )}
  {section === 'db' && (
    <g>
      <ellipse cx="12" cy="6" rx="7" ry="3"/>
      <path d="M5 6v8c0 1.7 3.1 3 7 3s7-1.3 7-3V6"/>
      <path d="M5 10c0 1.7 3.1 3 7 3s7-1.3 7-3"/>
    </g>
  )}
  {section === 'k8s' && (
    <g>
      <path d="M12 3.2 19 7v10l-7 3.8L5 17V7l7-3.8z"/>
      <path d="M12 8.5v7M9 10.2l6 3.6M15 10.2 9 13.8"/>
    </g>
  )}
  {section === 'system-design' && (
    <g>
      <circle cx="7" cy="8" r="2.3"/>
      <circle cx="17" cy="8" r="2.3"/>
      <circle cx="12" cy="17" r="2.3"/>
      <path d="M8.8 9.5 10.6 15M15.2 9.5 13.4 15M9.4 8h5.2"/>
    </g>
  )}
  {section === 'ai' && (
    <g>
      <path d="M12 3.5 13.2 8l4.8.3-3.7 3.1 1.2 4.6L12 13.6 8.5 16l1.2-4.6L6 8.3 10.8 8 12 3.5z"/>
    </g>
  )}
</svg>
