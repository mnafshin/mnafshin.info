<dialog class="shortcut-help" data-shortcut-help aria-labelledby="shortcut-help-title">
  <div class="shortcut-help-panel">
    <h2 id="shortcut-help-title">Keyboard shortcuts</h2>
    <dl>
      <div><dt><kbd>/</kbd></dt><dd>Open search</dd></div>
      <div><dt><kbd>Ctrl</kbd> / <kbd>⌘</kbd> <kbd>K</kbd></dt><dd>Open search</dd></div>
      <div><dt><kbd>J</kbd> or <kbd>→</kbd></dt><dd>Next article in the learning path</dd></div>
      <div><dt><kbd>K</kbd> or <kbd>←</kbd></dt><dd>Previous article in the learning path</dd></div>
      <div><dt><kbd>?</kbd></dt><dd>This help</dd></div>
      <div><dt><kbd>Esc</kbd></dt><dd>Close this help or search</dd></div>
    </dl>
    <button type="button" class="article-action" data-shortcut-help-close>Close</button>
  </div>
</dialog>
