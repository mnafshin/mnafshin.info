---
import ComingSoon from '../../components/ComingSoon.astro';
import CurriculumIndex from '../../components/CurriculumIndex.astro';
import TopicMap from '../../components/TopicMap.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { matchCurriculumArticle } from '../../lib/curriculum-topics';
import { getSection, LINKS, withBase } from '../../lib/site';
import { breadcrumbList } from '../../lib/structured-data';
import { SPRING_UPCOMING_CURRICULUM, getConceptArticles } from '../../lib/spring';
import { getPublishedVideosByDate, videoPath, type VideoEntry } from '../../lib/videos';

const section = getSection('spring');
const jsonLd = [
  breadcrumbList(
    [{ label: 'Home', href: withBase() }, { label: section.name }],
    new URL(Astro.url.pathname, Astro.site),
    Astro.site,
  ),
];
const articles = await getConceptArticles();
const weeklies = await getPublishedVideosByDate();
const upcoming = SPRING_UPCOMING_CURRICULUM.filter(
  (topic) => !matchCurriculumArticle(topic, articles),
);

function formatDate(video: VideoEntry) {
  return video.data.pubDate.toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'Europe/Berlin',
  });
}
---
<BaseLayout title={section.name} description={section.tagline} jsonLd={jsonLd}>
  <div class="wrap-narrow section-page">
    <p class="eyebrow">Articles</p>
    <h1>{section.name}</h1>
    <p class="lede">
      Short written articles on Spring and Spring Boot. Each one teaches a
      concept on its own, with the related videos from the
      <a href={LINKS.springuniverse}>SpringUniverse YouTube channel</a>
      beside it. Later curriculum topics without an article yet follow as
      coming soon.
    </p>

    {articles.length === 0 ? (
      <ComingSoon name="SpringUniverse" />
    ) : (
      <section class="article-index" aria-labelledby="articles-heading">
        <h2 id="articles-heading" class="page-title">Articles</h2>
        <ol class="toc-list">
          {articles.map((article, index) => (
            <li>
              <span class="step-number" aria-hidden="true">{index + 1}</span>
              <a href={withBase(`spring/${article.id}/`)}>{article.data.title}</a>
              <p class="muted toc-blurb">{article.data.description}</p>
            </li>
          ))}
        </ol>
      </section>
    )}

    {upcoming.length > 0 && (
      <section class="article-index" aria-labelledby="upcoming-heading">
        <h2 id="upcoming-heading" class="page-title">Upcoming</h2>
        <CurriculumIndex topics={upcoming} articles={articles} sectionPath="spring" />
      </section>
    )}

    <TopicMap articles={articles} sectionPath="spring" termsLabel="Spring annotations" />

    {weeklies.length > 0 && (
      <section class="weekly-index" aria-labelledby="weekly-heading">
        <h2 id="weekly-heading" class="page-title">Weekly reviews</h2>
        <ol class="toc-list">
          {weeklies.map((video) => (
            <li>
              <span class="series-label">{video.data.seriesLabel}</span>
              <a href={withBase(videoPath(video.id))}>{video.data.title}</a>
              <p class="meta">
                <time datetime={video.data.pubDate.toISOString()}>{formatDate(video)}</time>
              </p>
            </li>
          ))}
        </ol>
      </section>
    )}
  </div>
</BaseLayout>
