---
import ArticleCard from '../../components/ArticleCard.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import CurriculumIndex from '../../components/CurriculumIndex.astro';
import GlossaryLink from '../../components/GlossaryLink.astro';
import LearningMap from '../../components/LearningMap.astro';
import TopicMap from '../../components/TopicMap.astro';
import SectionIcon from '../../components/SectionIcon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { matchCurriculumArticle } from '../../lib/curriculum-topics';
import { articleCover, youtubeThumb } from '../../lib/covers';
import { getSection, LINKS, withBase } from '../../lib/site';
import { breadcrumbList, learningCourse, readingMinutes, wordCount } from '../../lib/structured-data';
import { SPRING_UPCOMING_CURRICULUM, getConceptArticles } from '../../lib/spring';
import { getPublishedVideosByDate, videoPath, type VideoEntry } from '../../lib/videos';

const section = getSection('spring');
const articles = await getConceptArticles();
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const jsonLd = [
  breadcrumbList(
    [{ label: 'Home', href: withBase() }, { label: section.name }],
    pageUrl,
    Astro.site,
  ),
  learningCourse({
    site: Astro.site,
    url: pageUrl,
    name: section.name,
    description: section.tagline,
    parts: articles.map((article) => ({
      name: article.data.title,
      url: new URL(withBase(`${section.path}/${article.id}/`), Astro.site).toString(),
    })),
  }),
];
const weeklies = await getPublishedVideosByDate();
const upcoming = SPRING_UPCOMING_CURRICULUM.filter(
  (topic) => !matchCurriculumArticle(topic, articles),
);
const mapTopics = [
  ...articles.map((article, index) => ({
    id: String(index + 1),
    title: article.data.title,
    articleId: article.id,
  })),
  ...upcoming,
];

function formatDate(video: VideoEntry) {
  return video.data.pubDate.toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'Europe/Berlin',
  });
}
---
<BaseLayout title={section.name} description={section.tagline} jsonLd={jsonLd}>
  <div class="wrap-narrow section-page" data-section={section.id}>
    <p class="eyebrow">Articles</p>
    <h1><SectionIcon section={section.id} size={32} /> {section.name}</h1>
    <p class="lede">
      Short written articles on Spring and Spring Boot. Each one teaches a
      concept on its own, with the related videos from the{' '}
      <a href={LINKS.springuniverse}>SpringUniverse YouTube channel</a>
      {' '}beside it. Later curriculum topics without an article yet follow as
      coming soon.
    </p>

    <LearningMap topics={mapTopics} articles={articles} sectionPath="spring" />
    <GlossaryLink sectionId="spring" />

    {articles.length === 0 ? (
      <ComingSoon name="SpringUniverse" />
    ) : (
      <section class="article-index" aria-labelledby="articles-heading">
        <h2 id="articles-heading" class="page-title">Articles</h2>
        <ol class="article-cards">
          {articles.map((article, index) => (
            <li>
              <span class="step-number" aria-hidden="true">{index + 1}</span>
              <ArticleCard
                href={withBase(`spring/${article.id}/`)}
                title={article.data.title}
                description={article.data.description}
                sectionId="spring"
                minutes={readingMinutes(wordCount(article.body))}
                cover={articleCover(article, 'spring')}
              />
            </li>
          ))}
        </ol>
      </section>
    )}

    {upcoming.length > 0 && (
      <section class="article-index" aria-labelledby="upcoming-heading">
        <h2 id="upcoming-heading" class="page-title">Upcoming</h2>
        <CurriculumIndex topics={upcoming} articles={articles} sectionPath="spring" />
      </section>
    )}

    <TopicMap articles={articles} sectionPath="spring" termsLabel="Spring annotations" />

    {weeklies.length > 0 && (
      <section class="weekly-index" aria-labelledby="weekly-heading">
        <h2 id="weekly-heading" class="page-title">Weekly reviews</h2>
        <ol class="article-cards">
          {weeklies.map((video) => (
            <li>
              <ArticleCard
                href={withBase(videoPath(video.id))}
                title={video.data.title}
                description={video.data.description}
                sectionId="spring"
                cover={youtubeThumb(video.data.youtubeId)}
                meta={`${video.data.seriesLabel} · ${formatDate(video)}`}
              />
            </li>
          ))}
        </ol>
      </section>
    )}
  </div>
</BaseLayout>
