---
import { render, type CollectionEntry } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import VideoLayout from '../../layouts/VideoLayout.astro';
import { getConceptArticles } from '../../lib/spring';
import { getPublishedVideos } from '../../lib/videos';

export async function getStaticPaths() {
  const articles = await getConceptArticles();
  // Only the weekly reviews keep their own video pages. The old tutorial
  // video URLs redirect to their concept articles (see astro.config.mjs).
  const videos = await getPublishedVideos();
  return [
    ...articles.map((article) => ({
      params: { slug: article.id },
      props: { kind: 'article' as const, article },
    })),
    ...videos.map((video) => ({
      params: { slug: video.id },
      props: { kind: 'video' as const, video },
    })),
  ];
}

type ArticleProps = { kind: 'article'; article: CollectionEntry<'spring'> };
type VideoProps = { kind: 'video'; video: CollectionEntry<'videos'> };
type Props = ArticleProps | VideoProps;

const props = Astro.props as Props;
const rendered = props.kind === 'video' ? await render(props.video) : await render(props.article);
const Content = rendered.Content;
---
{props.kind === 'video' ? (
  <VideoLayout video={props.video}>
    <Content />
  </VideoLayout>
) : (
  <ArticleLayout article={props.article}>
    <Content />
  </ArticleLayout>
)}
