---
import ComingSoon from '../../components/ComingSoon.astro';
import TopicMap from '../../components/TopicMap.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSection, withBase } from '../../lib/site';
import { breadcrumbList } from '../../lib/structured-data';
import { getDbConceptArticles, getDbWeeklies, type DbArticle } from '../../lib/db';

const section = getSection('db');
const jsonLd = [
  breadcrumbList(
    [{ label: 'Home', href: withBase() }, { label: section.name }],
    new URL(Astro.url.pathname, Astro.site),
    Astro.site,
  ),
];
const articles = await getDbConceptArticles();
const weeklies = await getDbWeeklies();

function formatDate(entry: DbArticle) {
  return entry.data.pubDate.toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'Europe/Berlin',
  });
}
---
<BaseLayout title={section.name} description={section.tagline} jsonLd={jsonLd}>
  <div class="wrap-narrow section-page">
    <p class="eyebrow">Articles</p>
    <h1>{section.name}</h1>
    <p class="lede">
      Short written articles on database concepts for backend developers, in
      learning order. Each one will teach a concept on its own, with related
      videos beside it once both exist. The topic list will appear here once
      the channel curriculum is published; it is not invented in the meantime.
    </p>

    {articles.length === 0 && weeklies.length === 0 && <ComingSoon name={section.name} />}

    <TopicMap articles={articles} sectionPath="db" termsLabel="Database terms" />

    {weeklies.length > 0 && (
      <section class="weekly-index" aria-labelledby="weekly-heading">
        <h2 id="weekly-heading" class="page-title">Weekly reviews</h2>
        <ol class="toc-list">
          {weeklies.map((weekly) => (
            <li>
              <a href={withBase(`db/${weekly.id}/`)}>{weekly.data.title}</a>
              <p class="meta">
                <time datetime={weekly.data.pubDate.toISOString()}>{formatDate(weekly)}</time>
              </p>
            </li>
          ))}
        </ol>
      </section>
    )}
  </div>
</BaseLayout>
