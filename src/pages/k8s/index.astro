---
import ComingSoon from '../../components/ComingSoon.astro';
import CurriculumIndex from '../../components/CurriculumIndex.astro';
import TopicMap from '../../components/TopicMap.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSection, withBase } from '../../lib/site';
import { breadcrumbList } from '../../lib/structured-data';
import {
  K8S_CURRICULUM,
  getK8sConceptArticles,
  getK8sWeeklies,
  type K8sArticle,
} from '../../lib/k8s';

const section = getSection('k8s');
const jsonLd = [
  breadcrumbList(
    [{ label: 'Home', href: withBase() }, { label: section.name }],
    new URL(Astro.url.pathname, Astro.site),
    Astro.site,
  ),
];
const articles = await getK8sConceptArticles();
const weeklies = await getK8sWeeklies();

function formatDate(entry: K8sArticle) {
  return entry.data.pubDate.toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'Europe/Berlin',
  });
}
---
<BaseLayout title={section.name} description={section.tagline} jsonLd={jsonLd}>
  <div class="wrap-narrow section-page">
    <p class="eyebrow">Articles</p>
    <h1>{section.name}</h1>
    <p class="lede">
      Short written articles on Kubernetes from a backend developer's point
      of view, in learning order. Each one teaches a concept on its own.
      Related videos from the KubePlained YouTube channel will appear beside
      them once the channel is public. Topics without an article yet are
      shown as coming soon.
    </p>

    {articles.length === 0 && weeklies.length === 0 && <ComingSoon name={section.name} />}

    <section class="article-index" aria-labelledby="curriculum-heading">
      <h2 id="curriculum-heading" class="page-title">Curriculum</h2>
      <CurriculumIndex topics={K8S_CURRICULUM} articles={articles} sectionPath="k8s" />
    </section>

    <TopicMap articles={articles} sectionPath="k8s" termsLabel="Kubernetes terms" />

    {weeklies.length > 0 && (
      <section class="weekly-index" aria-labelledby="weekly-heading">
        <h2 id="weekly-heading" class="page-title">Weekly reviews</h2>
        <ol class="toc-list">
          {weeklies.map((weekly) => (
            <li>
              <a href={withBase(`k8s/${weekly.id}/`)}>{weekly.data.title}</a>
              <p class="meta">
                <time datetime={weekly.data.pubDate.toISOString()}>{formatDate(weekly)}</time>
              </p>
            </li>
          ))}
        </ol>
      </section>
    )}
  </div>
</BaseLayout>
