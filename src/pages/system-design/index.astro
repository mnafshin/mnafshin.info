---
import ComingSoon from '../../components/ComingSoon.astro';
import CurriculumIndex from '../../components/CurriculumIndex.astro';
import TopicMap from '../../components/TopicMap.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSection, withBase } from '../../lib/site';
import { breadcrumbList } from '../../lib/structured-data';
import type { CurriculumTopic } from '../../lib/curriculum-topics';
import {
  SYSTEM_DESIGN_CURRICULUM,
  getSystemDesignConceptArticles,
  getSystemDesignWeeklies,
  type SystemDesignArticle,
} from '../../lib/system-design';

const section = getSection('system-design');
const jsonLd = [
  breadcrumbList(
    [{ label: 'Home', href: withBase() }, { label: section.name }],
    new URL(Astro.url.pathname, Astro.site),
    Astro.site,
  ),
];
const articles = await getSystemDesignConceptArticles();
const weeklies = await getSystemDesignWeeklies();

const topics: CurriculumTopic[] = SYSTEM_DESIGN_CURRICULUM.map((topic) => ({
  id: topic.id,
  title: topic.title,
  group: `Part ${topic.part} — ${topic.partTitle}`,
}));

function formatDate(entry: SystemDesignArticle) {
  return entry.data.pubDate.toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'Europe/Berlin',
  });
}
---
<BaseLayout title={section.name} description={section.tagline} jsonLd={jsonLd}>
  <div class="wrap-narrow section-page">
    <p class="eyebrow">Articles</p>
    <h1>{section.name}</h1>
    <p class="lede">
      Short written articles on distributed-systems and platform architecture
      for senior and staff backend engineers, in learning order. Each one
      teaches one idea and its trade-offs. Related videos will appear beside
      them once the YouTube channel is public (name and handle TBD). Topics
      without an article yet are shown as coming soon.
    </p>

    {articles.length === 0 && weeklies.length === 0 && <ComingSoon name={section.name} />}

    <section class="article-index" aria-labelledby="curriculum-heading">
      <h2 id="curriculum-heading" class="page-title">Curriculum</h2>
      <CurriculumIndex topics={topics} articles={articles} sectionPath="system-design" />
    </section>

    <TopicMap articles={articles} sectionPath="system-design" termsLabel="Architecture terms" />

    {weeklies.length > 0 && (
      <section class="weekly-index" aria-labelledby="weekly-heading">
        <h2 id="weekly-heading" class="page-title">Weekly reviews</h2>
        <ol class="toc-list">
          {weeklies.map((weekly) => (
            <li>
              <a href={withBase(`system-design/${weekly.id}/`)}>{weekly.data.title}</a>
              <p class="meta">
                <time datetime={weekly.data.pubDate.toISOString()}>{formatDate(weekly)}</time>
              </p>
            </li>
          ))}
        </ol>
      </section>
    )}
  </div>
</BaseLayout>
