---
import ComingSoon from '../components/ComingSoon.astro';
import PostList from '../components/PostList.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAllPublishedPosts, getVisibleSections } from '../lib/posts';
import { LINKS, SITE_DESCRIPTION, withBase } from '../lib/site';
import { getLatestVideos } from '../lib/latest-videos';

const posts = await getAllPublishedPosts();
const videos = (await getLatestVideos()).slice(0, 5);
const publicSections = await getVisibleSections();

function formatDate(date: Date) {
  return date.toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'Europe/Berlin',
  });
}
---
<BaseLayout description={SITE_DESCRIPTION}>
  <div class="wrap">
    <section class="hero">
      <h1>Afshin Amini</h1>
      <p class="lede">
        I’m a Java and Spring developer. I teach on YouTube and write here about
        the same topics: practical Spring work, and clear explanations of the
        terms that keep coming up.
      </p>
      <ul class="link-row">
        <li><a href={LINKS.springuniverse}>SpringUniverse on YouTube</a></li>
        <li><a href={LINKS.termsplained}>Termsplained on YouTube</a></li>
        <li><a href={LINKS.github}>GitHub</a></li>
        <li><a href={LINKS.linkedin}>LinkedIn</a></li>
      </ul>
    </section>

    <section>
      <h2 class="page-title">Blogs</h2>
      <div class="cards">
        {publicSections.map((section) => (
          <a class="card" href={withBase(`${section.path}/`)}>
            <p class="eyebrow">Section</p>
            <h3>{section.name}</h3>
            <p class="muted">{section.tagline}</p>
          </a>
        ))}
      </div>
    </section>

    <section>
      <h2 class="page-title">Latest videos</h2>
      {videos.length === 0 ? (
        <ComingSoon name="Videos" />
      ) : (
        <>
          <ol class="toc-list home-video-list">
            {videos.map((video) => (
              <li>
                <span class="series-label">{video.label}</span>
                <a href={withBase(video.path)}>{video.title}</a>
                <p class="meta">
                  <time datetime={video.pubDate.toISOString()}>
                    {formatDate(video.pubDate)}
                  </time>
                </p>
              </li>
            ))}
          </ol>
          <p>
            <a href={withBase('spring/')}>All SpringUniverse articles and weekly reviews</a>
          </p>
        </>
      )}
    </section>

    <section>
      <h2 class="page-title">Latest posts</h2>
      {posts.length === 0 ? (
        <ComingSoon name="This site" />
      ) : (
        <PostList posts={posts} showSection={true} />
      )}
    </section>
  </div>
</BaseLayout>
