---
import ArticleCard from '../../components/ArticleCard.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import CurriculumIndex from '../../components/CurriculumIndex.astro';
import LearningMap from '../../components/LearningMap.astro';
import TopicMap from '../../components/TopicMap.astro';
import SectionIcon from '../../components/SectionIcon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articleCover } from '../../lib/covers';
import { getSection, LINKS, withBase } from '../../lib/site';
import { breadcrumbList, readingMinutes, wordCount } from '../../lib/structured-data';
import {
  TERMS_CURRICULUM,
  getTermsConceptArticles,
  getTermsWeeklies,
  type TermsArticle,
} from '../../lib/terms';

const section = getSection('terms');
const jsonLd = [
  breadcrumbList(
    [{ label: 'Home', href: withBase() }, { label: section.name }],
    new URL(Astro.url.pathname, Astro.site),
    Astro.site,
  ),
];
const articles = await getTermsConceptArticles();
const weeklies = await getTermsWeeklies();

function formatDate(entry: TermsArticle) {
  return entry.data.pubDate.toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'Europe/Berlin',
  });
}
---
<BaseLayout title={section.name} description={section.tagline} jsonLd={jsonLd}>
  <div class="wrap-narrow section-page" data-section={section.id}>
    <p class="eyebrow">Articles</p>
    <h1><SectionIcon section={section.id} size={32} /> {section.name}</h1>
    <p class="lede">
      Short written articles that explain one AI term each, in learning
      order, with the related videos from the{' '}
      <a href={LINKS.termsplained}>Termsplained YouTube channel</a>
      {' '}beside them. Topics without an article yet are shown as coming soon.
      Weekly reviews of AI news follow below.
      A short <a href={withBase("terms/glossary/")}>A–Z glossary</a> lists every published term.
    </p>

    <LearningMap topics={TERMS_CURRICULUM} articles={articles} sectionPath="terms" />

    {articles.length === 0 && weeklies.length === 0 && <ComingSoon name={section.name} />}

    <section class="article-index" aria-labelledby="articles-heading">
      <h2 id="articles-heading" class="page-title">Articles</h2>
      <CurriculumIndex topics={TERMS_CURRICULUM} articles={articles} sectionPath="terms" />
    </section>

    <TopicMap articles={articles} sectionPath="terms" termsLabel="AI terms" />

    {weeklies.length > 0 && (
      <section class="weekly-index" aria-labelledby="weekly-heading">
        <h2 id="weekly-heading" class="page-title">Weekly reviews</h2>
        <ol class="article-cards">
          {weeklies.map((weekly) => (
            <li>
              <ArticleCard
                href={withBase(`terms/${weekly.id}/`)}
                title={weekly.data.title}
                description={weekly.data.description}
                sectionId="terms"
                minutes={readingMinutes(wordCount(weekly.body))}
                cover={articleCover(weekly, 'terms')}
                meta={formatDate(weekly)}
              />
            </li>
          ))}
        </ol>
      </section>
    )}
  </div>
</BaseLayout>
