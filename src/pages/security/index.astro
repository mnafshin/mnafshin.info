---
import ArticleCard from '../../components/ArticleCard.astro';
import ComingSoon from '../../components/ComingSoon.astro';
import CurriculumIndex from '../../components/CurriculumIndex.astro';
import GlossaryLink from '../../components/GlossaryLink.astro';
import LearningMap from '../../components/LearningMap.astro';
import TopicMap from '../../components/TopicMap.astro';
import SectionIcon from '../../components/SectionIcon.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { articleCover } from '../../lib/covers';
import { getSection, withBase } from '../../lib/site';
import { breadcrumbList, learningCourse, readingMinutes, wordCount } from '../../lib/structured-data';
import {
  SECURITY_CURRICULUM,
  getSecurityConceptArticles,
  getSecurityWeeklies,
  type SecurityArticle,
} from '../../lib/security';

const section = getSection('security');
const articles = await getSecurityConceptArticles();
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const jsonLd = [
  breadcrumbList(
    [{ label: 'Home', href: withBase() }, { label: section.name }],
    pageUrl,
    Astro.site,
  ),
  learningCourse({
    site: Astro.site,
    url: pageUrl,
    name: section.name,
    description: section.tagline,
    parts: articles.map((article) => ({
      name: article.data.title,
      url: new URL(withBase(`${section.path}/${article.id}/`), Astro.site).toString(),
    })),
  }),
];
const weeklies = await getSecurityWeeklies();

function formatDate(entry: SecurityArticle) {
  return entry.data.pubDate.toLocaleDateString('en-GB', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'Europe/Berlin',
  });
}
---
<BaseLayout title={section.name} description={section.tagline} jsonLd={jsonLd}>
  <div class="wrap-narrow section-page" data-section={section.id}>
    <p class="eyebrow">Articles</p>
    <h1><SectionIcon section={section.id} size={32} /> {section.name}</h1>
    <p class="lede">
      Short written articles on software security concepts for working
      developers, in learning order. Each one teaches a concept on its own.
      Related videos will appear beside them once the matching article is
      published. The list below is the first wave of the channel curriculum.
      Topics without an article yet are shown as coming soon.
    </p>

    <LearningMap topics={SECURITY_CURRICULUM} articles={articles} sectionPath="security" />
    <GlossaryLink sectionId="security" />

    {articles.length === 0 && weeklies.length === 0 && <ComingSoon name={section.name} />}

    <section class="article-index" aria-labelledby="curriculum-heading">
      <h2 id="curriculum-heading" class="page-title">Curriculum</h2>
      <CurriculumIndex topics={SECURITY_CURRICULUM} articles={articles} sectionPath="security" />
    </section>

    <TopicMap articles={articles} sectionPath="security" termsLabel="Security terms" />

    {weeklies.length > 0 && (
      <section class="weekly-index" aria-labelledby="weekly-heading">
        <h2 id="weekly-heading" class="page-title">Weekly reviews</h2>
        <ol class="article-cards">
          {weeklies.map((weekly) => (
            <li>
              <ArticleCard
                href={withBase(`security/${weekly.id}/`)}
                title={weekly.data.title}
                description={weekly.data.description}
                sectionId="security"
                minutes={readingMinutes(wordCount(weekly.body))}
                cover={articleCover(weekly, 'security')}
                meta={formatDate(weekly)}
              />
            </li>
          ))}
        </ol>
      </section>
    )}
  </div>
</BaseLayout>
