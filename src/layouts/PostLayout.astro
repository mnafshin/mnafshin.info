---
import type { MarkdownHeading } from 'astro';
import type { CollectionEntry } from 'astro:content';
import ArticleActions from '../components/ArticleActions.astro';
import ReadingBar from '../components/ReadingBar.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { Crumb, TocItem } from '../lib/nav';
import { ogImageUrl, ogKey } from '../lib/og';
import { contentFile, displayUpdatedDate, suggestEditUrl } from '../lib/content-meta';
import { markdownPath } from '../lib/markdown-pages';
import { getSection, SITE_TITLE, type SectionId, withBase } from '../lib/site';
import { isPublicVideo } from '../lib/articles';
import {
  blogPosting,
  breadcrumbList,
  pageDescription,
  readingMinutes,
  videoObject,
  wordCount,
} from '../lib/structured-data';
import BaseLayout from './BaseLayout.astro';

interface Props {
  sectionId: SectionId;
  post: CollectionEntry<SectionId>;
  /** The article's own headings, for the table of contents. */
  headings?: MarkdownHeading[];
  /** Sections the layout adds after the body, listed at the end of the contents. */
  tocExtra?: TocItem[];
  /** Show a 👍 link that jumps to the giscus reactions on this page. */
  like?: boolean;
}

const { sectionId, post, headings = [], tocExtra = [], like = false } = Astro.props;
const section = getSection(sectionId);
const isWeekly = 'kind' in post.data && post.data.kind === 'weekly';
const date = post.data.pubDate.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'Europe/Berlin',
});
const sourceFile = contentFile(sectionId, post.id);
const updatedDate = displayUpdatedDate(post.data.pubDate, post.data.updatedDate, sourceFile);
const updated = updatedDate
  ? updatedDate.toLocaleDateString('en-GB', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      timeZone: 'Europe/Berlin',
    })
  : null;
const editHref = suggestEditUrl(sourceFile);

const sectionHref = withBase(`${section.path}/`);
const crumbs: Crumb[] = [
  { label: 'Home', href: withBase() },
  { label: section.name, href: sectionHref, sectionId },
  ...(isWeekly ? [{ label: 'Weekly reviews', href: `${sectionHref}#weekly-heading` }] : []),
  { label: post.data.title },
];

const words = wordCount(post.body);
const minutes = readingMinutes(words);
const pageUrl = new URL(Astro.url.pathname, Astro.site);
const key = ogKey(`${section.path}/${post.id}`);
const description = pageDescription(post.data) || post.data.description;
const markdownUrl = withBase(markdownPath(section.path, post.id));
const relatedVideos =
  'relatedVideos' in post.data ? post.data.relatedVideos.filter(isPublicVideo) : [];
const jsonLd = [
  blogPosting({
    site: Astro.site,
    url: pageUrl,
    title: post.data.title,
    description,
    image: ogImageUrl(key, Astro.site),
    published: post.data.pubDate,
    modified: updatedDate,
    sectionName: section.name,
    sectionUrl: new URL(sectionHref, Astro.site).toString(),
    keywords: post.data.tags,
    wordCount: words,
  }),
  breadcrumbList(crumbs, pageUrl, Astro.site),
  ...relatedVideos.map((video) =>
    videoObject({
      name: video.title,
      youtubeId: video.youtubeId,
      uploadDate: 'pubDate' in video ? video.pubDate : undefined,
    }),
  ),
];
---
<BaseLayout
  title={post.data.title}
  description={description}
  markdownUrl={markdownUrl}
  ogImage={key}
  ogType="article"
  publishedTime={post.data.pubDate}
  modifiedTime={updatedDate}
  jsonLd={jsonLd}
>
  <ReadingBar />
  <article
    class="wrap-narrow article"
    data-section={sectionId}
    data-pagefind-body
    data-pagefind-meta={`section:${section.name}`}
    data-pagefind-filter={`section:${section.name}`}
  >
    <span hidden data-pagefind-meta={`kind:${isWeekly ? 'Weekly review' : 'Article'}`}></span>
    <Breadcrumbs items={crumbs} />
    <h1 data-pagefind-meta="title">{post.data.title}</h1>
    <p class="meta" data-pagefind-ignore>
      <a class="article-author" href={withBase('about/')}>{SITE_TITLE}</a>
      {' '}· <time datetime={post.data.pubDate.toISOString()}>{date}</time>
      {updated && (
        <>
          {' '}
          · Updated <time datetime={updatedDate?.toISOString()}>{updated}</time>
        </>
      )}
      {' '}· {minutes} min read
      {editHref && (
        <>
          {' '}· <a class="article-edit" href={editHref}>Suggest an edit</a>
        </>
      )}
    </p>
    <ArticleActions title={post.data.title} section={section.name} like={like} />
    <TableOfContents headings={headings} extra={tocExtra} />
    {post.data.summary && (
      <aside class="in-short" aria-labelledby="in-short-heading">
        <p id="in-short-heading" class="in-short-label">In short</p>
        <p class="in-short-body">{post.data.summary}</p>
      </aside>
    )}
    <slot />
  </article>
</BaseLayout>
