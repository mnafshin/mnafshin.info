---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { isPreviewHost, SITE_DESCRIPTION, SITE_TITLE, withBase } from '../lib/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
}

const {
  title,
  description = SITE_DESCRIPTION,
  canonicalPath,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const preview = isPreviewHost(Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {preview && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE_TITLE} — all posts`} href={withBase('rss.xml')} />
    <link rel="alternate" type="application/rss+xml" title="SpringUniverse" href={withBase('spring/rss.xml')} />
    <link rel="alternate" type="application/rss+xml" title="Termsplained" href={withBase('terms/rss.xml')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = stored === 'light' || stored === 'dark' ? stored : prefersDark ? 'dark' : 'light';
          document.documentElement.classList.toggle('dark', theme === 'dark');
        } catch (error) {
          /* localStorage can be unavailable */
        }
      })();
    </script>
  </head>
  <body>
    <Header />
    <main id="content">
      <slot />
    </main>
    <Footer />
  </body>
</html>
